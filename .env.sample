# To set these as env vars in Windows cmd:
#   for /f "usebackq tokens=1,* delims==" %i in (.env) do set %i=%j
OPENAI_BASE_URL=https://your-endpoint.openai.azure.com/openai
OPENAI_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...  # optional; omit for Entra ID auth

# Optional LangSmith tracing. Set LANGSMITH_API_KEY to enable tracing;
# leave it unset to keep tracing off. Set LANGSMITH_TRACING=false to
# force tracing off even when a key is present.
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_PROJECT=one-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
